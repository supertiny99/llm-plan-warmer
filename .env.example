# ====================================================================
# llm-plan-warmer 环境变量配置文件范例 (.env.example)
#
# 使用指南：
# 1. 本地测试：复制此文件为 .env，修改下方配置后直接运行 python warmer.py
# 2. GitHub Actions 部署：直接复制 LLM_ACCOUNTS 的 JSON 字符串到 GitHub Secrets 中
# ====================================================================

# 多账号 & 多供应商核心配置 (api_key 与 model 均支持单字符串或多字符串数组)
#
# 推荐调度 (配合 .github/workflows/warmer.yml 的四行 UTC cron):
#   trigger_hours: [0, 8, 13, 18]  →  锚点 00:10 / 08:10 / 13:30 / 18:50 (北京时间，间隔 5h20m)
#   窗口: 00:10-05:10 (夜间) / 08:10-13:10 (上午工作段) / 13:30-18:30 (下午工作段) / 18:50-23:50 (晚间)
#   全部锚点避开工作日 14:00-18:00 峰时三倍消耗时段；结构性空洞仅剩 05:10-08:10 (详见 README)
LLM_ACCOUNTS='[
  {
    "name": "智谱 Coding Plan (多账号批量预热)",
    "api_key": [
      "your-zhipu-api-key-1",
      "your-zhipu-api-key-2"
    ],
    "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
    "model": "glm-4.7",
    "trigger_hours": [0, 8, 13, 18],
    "avoid_weekday_peak": true
  },
  {
    "name": "商汤 SenseNova Token Plan (多Key + 多模型组合预热)",
    "api_key": [
      "your-sensenova-key-1",
      "your-sensenova-key-2"
    ],
    "base_url": "https://token.sensenova.cn/v1",
    "model": [
      "sensenova-6.7-flash-lite",
      "sensenova-u1-fast",
      "deepseek-v4-flash",
      "glm-5.2"
    ],
    "image_models": ["sensenova-u1-fast"],
    "trigger_hours": [0, 8, 13, 18]
  },
  {
    "name": "DeepSeek API (每日早晚各一次)",
    "api_key": "your-deepseek-api-key",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "trigger_hours": [8, 18]
  }
]'
