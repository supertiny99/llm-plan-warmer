# ====================================================================
# llm-plan-warmer 环境变量配置文件范例 (.env.example)
#
# 使用指南：
# 1. 本地测试：复制此文件为 .env，修改下方配置后直接运行 python warmer.py
# 2. GitHub Actions 部署：直接复制 LLM_ACCOUNTS 的 JSON 字符串到 GitHub Secrets 中
# ====================================================================

# 多账号 & 多供应商核心配置 (支持单模型字符串或多模型数组)
LLM_ACCOUNTS='[
  {
    "name": "智谱 Coding Plan (5小时刷新)",
    "api_key": "your-zhipu-api-key",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "model": "glm-4-flash",
    "trigger_hours": [5, 10, 15, 20]
  },
  {
    "name": "商汤 SenseNova Token Plan (按模型分别冷却)",
    "api_key": "your-sensenova-api-key",
    "base_url": "https://token.sensenova.cn/v1",
    "model": [
      "sensenova-6.7-flash-lite",
      "sensenova-u1-fast",
      "deepseek-v4-flash",
      "gml-5.2"
    ],
    "trigger_hours": [5, 10, 15, 20]
  },
  {
    "name": "DeepSeek API (3小时刷新)",
    "api_key": "your-deepseek-api-key",
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "trigger_hours": [6, 9, 12, 15, 18, 21]
  },
  {
    "name": "Kimi (Moonshot) (4小时间隔)",
    "api_key": "your-kimi-api-key",
    "base_url": "https://api.moonshot.cn/v1",
    "model": "moonshot-v1-8k",
    "interval_hours": 4
  }
]'
